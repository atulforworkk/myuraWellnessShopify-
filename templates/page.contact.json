x-width: 220px;\n  max-height: 300px;\n  border-radius: 12px;\n}\n\n.contact-details {\n  flex: 1;\n  font-size: 16px;\n  color: #333;\n}\n\n.contact-details h2 {\n  font-size: 24px;\n  margin-bottom: 20px;\n  font-weight: 600;\n  color: #222;\n}\n\n.contact-details p {\n  margin: 8px 0;\n  line-height: 1.6;\n}\n\n.contact-details a {\n  color: #1a7f5a; /* brand green */\n  text-decoration: none;\n  font-weight: 500;\n}\n\n.contact-details a:hover {\n  text-decoration: underline;\n}\n\n.social-icons {\n  margin-top: 20px;\n  display: flex;\n  gap: 15px;\n}\n\n.social-icons a {\n  font-size: 22px;\n  color: #1a7f5a;\n  transition: color 0.3s ease;\n}\n\n.social-icons a:hover {\n  color: #0e4c36;\n}\n</style>\n\n  <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css\" rel=\"stylesheet\">",
