        "custom_liquid": "<!-- footer.liquid -->\n<footer class=\"myura-footer\" >\n  <div class=\"footer-container\" data-aos=\"fade-up\" data-aos-duration=\"800\">\n\n    <!-- Left: Logo + About + Social -->\n    <div class=\"footer-about\">\n      <img src=\"{{ 'Myura_logo.png' | asset_url }}\" alt=\"Myura Logo\" class=\"footer-logo\">\n      <p>Ayurvedic wellness made simple. Myura offers honest, natural supplements for daily vitality, balance, and better living — no shortcuts, just nature.</p>\n\n      <!-- Social Media Icons -->\n      <div class=\"footer-social\">\n        <a href=\"https://www.facebook.com/myurawellness\" target=\"_blank\" aria-label=\"Facebook\"><i class=\"fab fa-facebook-f\"></i></a>\n        <a href=\"https://www.instagram.com/myurawellness/\" target=\"_blank\" aria-label=\"Instagram\"><i class=\"fab fa-instagram\"></i></a>\n        <a href=\"https://www.youtube.com/@MyuraWellness\" target=\"_blank\" aria-label=\"YouTube\"><i class=\"fab fa-youtube\"></i></a>\n        <a href=\"https://www.pinterest.com/myurawellness\" target=\"_blank\" aria-label=\"Pinterest\"><i class=\"fab fa-pinterest-p\"></i></a>\n        <a href=\"https://x.com/Myurawellness\" target=\"_blank\" aria-label=\"X (Twitter)\"><i class=\"fab fa-twitter\"></i></a>\n        <a href=\"https://www.threads.net/@myurawellness\" target=\"_blank\" aria-label=\"Threads\"><i class=\"fa-brands fa-threads\"></i></a>\n        <a href=\"https://www.linkedin.com/company/myurawellness\" target=\"_blank\" aria-label=\"LinkedIn\"><i class=\"fab fa-linkedin-in\"></i></a>\n      </div>\n    </div>\n\n    <!-- Middle: Our Links -->\n    <div class=\"footer-links\">\n      <h4>Our Links</h4>\n      <ul>\n        <li><a href=\"/pages/faqs\">Faqs</a></li>\n        <li><a href=\"/pages/disclaimer\">Disclaimer</a></li>\n        <li><a href=\"/pages/brand-directory\">Brand Directory</a></li>\n        <li><a href=\"/pages/return-policy\">Returns Policy</a></li>\n        <li><a href=\"/pages/terms-and-conditions\">Terms Conditions</a></li>\n        <li><a href=\"/pages/privacy-policy\">Privacy Policy</a></li>\n      </ul>\n    </div>\n\n    <!-- Accounts -->\n    <div class=\"footer-accounts\">\n      <h4>Accounts</h4>\n      <ul>\n        <li><a href=\"/cart\">Cart</a></li>\n        <li><a href=\"/checkout\">Checkout</a></li>\n        <li><a href=\"/account\">My account</a></li>\n      </ul>\n    </div>\n\n    <!-- Contacts -->\n    <div class=\"footer-contacts\">\n      <h4>Contacts</h4>\n      <p><i class=\"fa-solid fa-phone\"></i> +91 9133 001 177</p>\n      <p>📧 <a href=\"mailto:care@myurawellness.com\">care@myurawellness.com</a></p>\n      <a href=\"https://maps.app.goo.gl/N2uqs2bSe4VwZbRN6?g_st=ipc\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <p><i class=\"fa-solid fa-location-dot\"></i> Plot No. 15C, IT Park, Sector 22, Panchkula, Haryana, 134109</p>\n      </a>\n    </div>\n  </div>\n\n  <!-- Bottom strip -->\n  <div class=\"footer-bottom\">\n    <p>MYURA Wellness is a brand of JAC Nutrition Pvt. Ltd. © 2025 JAC Nutrition Pvt. Ltd. All Rights Reserved.</p>\n    <div class=\"payment-icons\">\n      <img src=\"{{ 'Visa.png' | asset_url }}\" alt=\"Visa\">\n      <img src=\"{{ 'Mastercard.png' | asset_url }}\" alt=\"MasterCard\">\n      <img src=\"{{ 'Amex.png' | asset_url }}\" alt=\"Amex\">\n    </div>\n  </div>\n</footer>\n\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css\" rel=\"stylesheet\">\n\n<style>\n/* ========== FOOTER STYLES ========== */\n.myura-footer {\n  background: linear-gradient(135deg, #8cb697, #5c7f6f);\n  color: #fff;\n  padding: 50px 20px 20px;\n  font-family: Arial, sans-serif;\n  width: 100%;\n  margin: 0 auto;\n}\n\n/* Fixed layout */\n.footer-container {\n  display: grid !important;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  align-items: flex-start;\n  gap: 40px;\n  padding: 0 40px;\n  box-sizing: border-box;\n}\n\n.footer-container > div {\n  width: 100%;\n  box-sizing: border-box;\n}\n\n.footer-logo {\n  max-width: 160px;\n  margin-bottom: 15px;\n}\n\n.footer-about p {\n  margin: 10px 0 20px;\n  line-height: 1.6;\n  color: #f0f0f0;\n}\n\n/* Headings */\n.footer-links h4,\n.footer-accounts h4,\n.footer-contacts h4 {\n  margin-bottom: 15px;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n/* Links */\n.footer-links ul,\n.footer-accounts ul {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.footer-links ul li,\n.footer-accounts ul li {\n  margin: 6px 0;\n}\n\n.footer-links ul li a,\n.footer-accounts ul li a {\n  color: #fff;\n  text-decoration: none;\n  transition: 0.3s;\n}\n\n.footer-links ul li a:hover,\n.footer-accounts ul li a:hover {\n  color: #3C6845;\n}\n\n/* Contacts */\n.footer-contacts p {\n  margin: 6px 0;\n}\n\n.footer-contacts a {\n  color: inherit;\n  text-decoration: none;\n}\n\n/* Social Icons */\n.footer-social {\n  margin-top: 15px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 15px;\n}\n\n.footer-social a {\n  font-size: 22px;\n  color: #fff;\n  transition: transform 0.3s ease, color 0.3s ease;\n}\n\n.footer-social a:hover {\n  color: #3c6845;\n  transform: scale(2.25);\n}\n\n/* Payment Icons */\n.payment-icons img {\n  width: 50px;\n  margin: 0 8px;\n  transition: transform 0.3s ease;\n}\n\n.payment-icons img:hover {\n  transform: scale(1.15);\n}\n\n/* Bottom strip */\n.footer-bottom {\n  border-top: 1px solid rgba(255, 255, 255, 0.3);\n  margin-top: 40px;\n  padding: 20px 40px 0;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  width: 100%;\n  box-sizing: border-box;\n}\n\n.footer-bottom p {\n  margin: 5px 0;\n}\n\n/* Mobile */\n@media (max-width: 768px) {\n  .footer-container {\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n  }\n  .footer-accounts ul {\n    display: flex;\n    gap: 15px;\n    flex-wrap: wrap;\n  }\n  .footer-accounts ul li {\n    margin: 0;\n  }\n}\n\n@media (max-width: 480px) {\n  .footer-container {\n    grid-template-columns: 1fr;\n  }\n  .footer-bottom {\n    flex-direction: column;\n    text-align: center;\n  }\n}\n</style>\n\n<!-- Optional AOS (slide/fade effect) -->\n<link href=\"https://unpkg.com/aos@2.3.4/dist/aos.css\" rel=\"stylesheet\">\n<script src=\"https://unpkg.com/aos@2.3.4/dist/aos.js\"></script>\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    AOS.init({ once: true });\n  });\n</script>",
