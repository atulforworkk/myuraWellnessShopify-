      "settings": {
        "custom_liquid": "<!-- HERO SLIDER -->\n<div class=\"hero-slider\" id=\"heroSlider\">\n  <!-- Desktop Slides -->\n  <div class=\"slide desktop-slide active\">\n    <img src=\"{{ 'ComingSoon.jpg' | asset_url }}\" alt=\"Desktop Slide 1\">\n  </div>\n  <!--  -->\n  <div class=\"slide desktop-slide\">\n    <img src=\"{{ 'Banner1Main.png' | asset_url }}\" alt=\"Desktop Slide 2\">\n  </div>\n  <div class=\"slide desktop-slide\">\n    <img src=\"{{ 'Banner 5.jpg' | asset_url }}\" alt=\"Desktop Slide 3\">\n  </div>\n\n  <!-- Navigation Buttons -->\n  <button class=\"hero-prev\">&#10094;</button>\n  <button class=\"hero-next\">&#10095;</button>\n\n  <!-- Mobile Slider (Swiper) -->\n  <div class=\"mobile-slider swiper\">\n    <div class=\"swiper-wrapper\">\n      <div class=\"swiper-slide\">\n        <img src=\"{{ 'website banner vertical.jpg'| asset_url }}\" alt=\"Mobile Slide 1\">\n      </div>\n      <div class=\"swiper-slide\">\n        <img src=\"{{ 'Banner12.jpg' | asset_url }}\" alt=\"Mobile Slide 2\">\n      </div>\n      <div class=\"swiper-slide\">\n        <img src=\"{{ 'Banner13.jpg' | asset_url }}\" alt=\"Mobile Slide 3\">\n      </div>\n    </div>\n    <!-- optional pagination -->\n    <div class=\"swiper-pagination\"></div>\n  </div>\n</div>\n\n<!-- Swiper CSS & JS -->\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\">\n<script src=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js\"></script>\n\n<style>\n.hero-slider {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 1500/625;\n  margin: 0 auto;\n  overflow: hidden;\n  border-radius: 12px;\n  background: #F0F4EB;\n}\n\n/* Desktop slides */\n.hero-slider .slide {\n  position: absolute;\n  inset: 0;\n  opacity: 0;\n  transition: opacity 1s ease-in-out;\n}\n\n.hero-slider .slide img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n\n.hero-slider .slide.active {\n  opacity: 1;\n}\n\n/* Navigation Buttons */\n.hero-prev, .hero-next {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  background: rgba(0,0,0,0.4);\n  color: white;\n  border: none;\n  padding: 12px 18px;\n  font-size: 24px;\n  border-radius: 50%;\n  cursor: pointer;\n  z-index: 10;\n  transition: background 0.3s;\n}\n\n.hero-prev:hover, .hero-next:hover {\n  background: rgba(0,0,0,0.6);\n}\n\n.hero-prev { left: 20px; }\n.hero-next { right: 20px; }\n\n/* Desktop only */\n@media (min-width: 769px) {\n  .mobile-slider { display: none; }\n  .desktop-slide { display: block; }\n}\n\n/* Mobile only (Swiper carousel) */\n@media (max-width: 768px) {\n  .hero-slider {\n    aspect-ratio: auto;\n    border-radius: 8px;\n  }\n\n  .desktop-slide, .hero-prev, .hero-next { display: none; }\n\n  .mobile-slider { display: block; }\n\n  .mobile-slider img {\n    width: 100%;\n    height: auto;\n    object-fit: contain;\n    background-color: #F0F4EB;\n    border-radius: 8px;\n  }\n\n  .swiper-pagination-bullet {\n    background: #333;\n    opacity: .6;\n  }\n  .swiper-pagination-bullet-active {\n    background: #000;\n    opacity: 1;\n  }\n}\n</style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  // Desktop slider manual + auto logic\n  const slides = document.querySelectorAll('.hero-slider .desktop-slide');\n  const nextBtn = document.querySelector('.hero-next');\n  const prevBtn = document.querySelector('.hero-prev');\n  let current = 0;\n  let autoPlay;\n\n  function showSlide(index) {\n    slides.forEach((slide, i) => slide.classList.toggle('active', i === index));\n  }\n\n  function nextSlide() {\n    current = (current + 1) % slides.length;\n    showSlide(current);\n  }\n\n  function prevSlide() {\n    current = (current - 1 + slides.length) % slides.length;\n    showSlide(current);\n  }\n\n  nextBtn.addEventListener('click', () => {\n    nextSlide();\n    resetAutoPlay();\n  });\n\n  prevBtn.addEventListener('click', () => {\n    prevSlide();\n    resetAutoPlay();\n  });\n\n  function startAutoPlay() {\n    autoPlay = setInterval(nextSlide, 7000); // auto crossfade every 7s\n  }\n\n  function resetAutoPlay() {\n    clearInterval(autoPlay);\n    startAutoPlay();\n  }\n\n  showSlide(current);\n  startAutoPlay();\n\n  // Mobile Swiper\n  if (window.innerWidth <= 768) {\n    new Swiper('.mobile-slider', {\n      slidesPerView: 1,\n      loop: true,\n      autoplay: {\n        delay: 5000,\n        disableOnInteraction: false,\n      },\n      pagination: {\n        el: '.swiper-pagination',\n        clickable: true,\n      },\n      navigation: {\n        nextEl: '.hero-next',\n        prevEl: '.hero-prev',\n      },\n    });\n  }\n});\n</script>",
