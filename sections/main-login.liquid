{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div class="auth-hero">
  <h1>Welcome back</h1>
  <p>Log in to manage orders, save addresses, and track your perks.</p>
</div>

<div class="auth-wrapper section-{{ section.id }}-padding">
  <div class="auth-card">

    <!-- Hidden Recover Password Form -->
    <div id="RecoverForm" style="display:none;">
      {%- form 'recover_customer_password' -%}
        {% assign recover_success = form.posted_successfully? %}
        <div class="field">
          <label for="RecoverEmail">Email</label>
          <input
            type="email"
            name="email"
            id="RecoverEmail"
            autocomplete="email"
            placeholder="you@example.com"
          >
        </div>

        <button type="submit">Send reset link</button>
      {%- endform -%}
    </div>

    <!-- Login Section -->
    <h2 id="login" tabindex="-1" style="margin-top: 12px;">Sign in</h2>

    {%- if recover_success == true -%}
      <div class="form__message" tabindex="-1" autofocus>
        {{ 'customer.recover_password.success' | t }}
      </div>
    {%- endif -%}

    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error" tabindex="-1" autofocus>
          {{ 'templates.contact.form.error_heading' | t }}
        </div>
        {{ form.errors | default_errors }}
      {%- endif -%}

      {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
        <section name="sign-in-with-shop-provider" style="margin-bottom: 12px;">
          {{ shop | login_button: hide_button: hide_shop_login_button }}
          {%- unless hide_shop_login_button -%}
            <p class="muted" style="text-align:center; margin: 10px 0;">or use your email</p>
          {%- endunless -%}
        </section>
      {%- endif -%}

      <div class="field">
        <label for="CustomerEmail">Email</label>
        <input
          type="email"
          name="customer[email]"
          id="CustomerEmail"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          placeholder="you@example.com"
          {% if form.errors contains 'form' %} aria-invalid="true" {% endif %}
        >
      </div>

      {%- if form.password_needed -%}
        <div class="field">
          <label for="CustomerPassword">Password</label>
          <input
            type="password"
            name="customer[password]"
            id="CustomerPassword"
            autocomplete="current-password"
            placeholder="Your password"
            {% if form.errors contains 'form' %} aria-invalid="true" {% endif %}
          >
        </div>
      {%- endif -%}

      <button type="submit" class="button-primary">Sign in</button>

      <div class="auth-links">
        <a href="#" id="OpenRecoverForm">Forgot password?</a>
        <a href="{{ routes.account_register_url }}">Create account</a>
      </div>
    {%- endform -%}

    {%- if shop.checkout.guest_login -%}
      <hr style="margin: 28px 0; border: 0; border-top: 1px solid #eee;">
      <h3 style="margin-bottom: 12px;">Continue as guest</h3>
      {%- form 'guest_login' -%}
        <button type="submit" class="button-ghost">Continue to checkout</button>
      {%- endform -%}
    {%- endif -%}

  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const trigger = document.getElementById("OpenRecoverForm");
    const recoverForm = document.getElementById("RecoverForm");

    if (trigger && recoverForm) {
      trigger.addEventListener("click", function (e) {
        e.preventDefault();
        recoverForm.style.display = "block";  // Show the hidden recover form
        recoverForm.scrollIntoView({ behavior: "smooth" });
      });
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
