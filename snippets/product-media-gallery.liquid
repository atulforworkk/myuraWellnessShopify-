{% comment %}
  Amazon-style product gallery
  – Desktop: thumbnails left, main image right
  – Mobile: thumbnails below the main image
{% endcomment %}

<div class="product-gallery">
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const thumbs = document.querySelectorAll(".product-thumbs .thumb");
      const mainImage = document.querySelector(".product-main-image img");

      thumbs.forEach(button => {
        button.addEventListener("click", function() {
          const largeUrl = this.getAttribute("data-large");
          const alt = this.querySelector("img").getAttribute("alt");

          mainImage.setAttribute("src", largeUrl);
          mainImage.setAttribute("alt", alt);

          // highlight active thumb
          thumbs.forEach(b => b.classList.remove("active"));
          this.classList.add("active");
        });
      });
      
      // Add premium zoom functionality
      if (mainImage) {
        // Add zoom styles
        mainImage.style.cursor = 'zoom-in';
        mainImage.style.transition = 'transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        mainImage.style.willChange = 'transform';
        
        // Desktop hover zoom
        if (window.innerWidth > 768) {
          mainImage.addEventListener('mouseenter', function() {
            this.style.transform = 'scale(1.03)';
          });
          
          mainImage.addEventListener('mouseleave', function() {
            this.style.transform = 'scale(1)';
          });
          
          // Click to zoom overlay
          mainImage.addEventListener('click', function(e) {
            e.preventDefault();
            showZoomOverlay(this);
          });
        }
        
        // Mobile touch zoom
        if (window.innerWidth <= 768) {
          let isZoomed = false;
          let scale = 1;
          let startX, startY, currentX = 0, currentY = 0;
          
          mainImage.addEventListener('touchstart', function(e) {
            if (e.touches.length === 1) {
              if (!isZoomed) {
                scale = 1.8;
                isZoomed = true;
                this.style.transform = `scale(${scale})`;
                this.style.cursor = 'grabbing';
                startX = e.touches[0].clientX - currentX;
                startY = e.touches[0].clientY - currentY;
              } else {
                scale = 1;
                isZoomed = false;
                this.style.transform = 'scale(1) translate(0px, 0px)';
                this.style.cursor = 'zoom-in';
                currentX = 0;
                currentY = 0;
              }
            }
          });
          
          mainImage.addEventListener('touchmove', function(e) {
            if (isZoomed) {
              e.preventDefault();
              currentX = e.touches[0].clientX - startX;
              currentY = e.touches[0].clientY - startY;
              
              // Constrain panning
              const maxX = (this.offsetWidth * (scale - 1)) / 2;
              const maxY = (this.offsetHeight * (scale - 1)) / 2;
              currentX = Math.max(-maxX, Math.min(maxX, currentX));
              currentY = Math.max(-maxY, Math.min(maxY, currentY));
              
              this.style.transform = `scale(${scale}) translate(${currentX}px, ${currentY}px)`;
            }
          });
        }
      }
      
      // Carousel data
      let currentImageIndex = 0;
      let allProductImages = [];
      
      // Get all product images
      function getAllProductImages() {
        const images = [];
        const thumbButtons = document.querySelectorAll('.product-thumbs .thumb');
        thumbButtons.forEach(button => {
          const img = button.querySelector('img');
          const largeUrl = button.getAttribute('data-large');
          if (img && largeUrl) {
            images.push({
              src: largeUrl,
              alt: img.alt,
              thumb: img.src
            });
          }
        });
        return images;
      }
      
      // Find current image index
      function findCurrentImageIndex(imageSrc) {
        return allProductImages.findIndex(img => img.src === imageSrc);
      }
      
      // Zoom overlay function with carousel
      function showZoomOverlay(image) {
        allProductImages = getAllProductImages();
        currentImageIndex = findCurrentImageIndex(image.src);
        
        let overlay = document.getElementById('zoom-overlay');
        if (!overlay) {
          overlay = document.createElement('div');
          overlay.id = 'zoom-overlay';
          overlay.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 9999;
            display: none;
            justify-content: center;
            align-items: center;
            cursor: zoom-out;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            opacity: 0;
            transition: opacity 0.3s ease;
            user-select: none;
            -webkit-user-select: none;
          `;
          
          // Image container
          const imageContainer = document.createElement('div');
          imageContainer.style.cssText = `
            position: relative;
            max-width: 90%;
            max-height: 90%;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            box-sizing: border-box;
          `;
          
          const zoomImg = document.createElement('img');
          zoomImg.id = 'zoom-carousel-image';
          zoomImg.style.cssText = `
            max-width: 85%;
            max-height: 85%;
            width: auto;
            height: auto;
            object-fit: contain;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
            transform: scale(0.9);
            transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
          `;
          
          // Navigation arrows
          const leftArrow = document.createElement('button');
          leftArrow.innerHTML = '‹';
          leftArrow.style.cssText = `
            position: absolute;
            left: -60px;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.9);
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            font-size: 24px;
            cursor: pointer;
            color: #333;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            opacity: 0.8;
          `;
          
          const rightArrow = document.createElement('button');
          rightArrow.innerHTML = '›';
          rightArrow.style.cssText = leftArrow.style.cssText;
          rightArrow.style.left = 'auto';
          rightArrow.style.right = '-60px';
          
          // Image counter
          const imageCounter = document.createElement('div');
          imageCounter.id = 'image-counter';
          imageCounter.style.cssText = `
            position: absolute;
            bottom: -50px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
          `;
          
          // Close button
          const closeBtn = document.createElement('button');
          closeBtn.innerHTML = '×';
          closeBtn.style.cssText = `
            position: absolute;
            top: 30px;
            right: 30px;
            background: rgba(255, 255, 255, 0.9);
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            font-size: 24px;
            cursor: pointer;
            color: #333;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
          `;
          
          imageContainer.appendChild(zoomImg);
          imageContainer.appendChild(leftArrow);
          imageContainer.appendChild(rightArrow);
          imageContainer.appendChild(imageCounter);
          overlay.appendChild(imageContainer);
          overlay.appendChild(closeBtn);
          document.body.appendChild(overlay);
          
          // Event listeners
          leftArrow.addEventListener('click', (e) => {
            e.stopPropagation();
            previousImage();
          });
          
          rightArrow.addEventListener('click', (e) => {
            e.stopPropagation();
            nextImage();
          });
          
          closeBtn.addEventListener('click', closeZoom);
          overlay.addEventListener('click', function(e) {
            if (e.target === overlay) closeZoom();
          });
          
          // Keyboard navigation
          document.addEventListener('keydown', function(e) {
            if (overlay.style.display === 'flex') {
              if (e.key === 'Escape') closeZoom();
              if (e.key === 'ArrowLeft') previousImage();
              if (e.key === 'ArrowRight') nextImage();
            }
          });
          
          // Touch swipe support
          let startX = 0;
          let startY = 0;
          
          overlay.addEventListener('touchstart', function(e) {
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
          });
          
          overlay.addEventListener('touchend', function(e) {
            if (!startX || !startY) return;
            
            const endX = e.changedTouches[0].clientX;
            const endY = e.changedTouches[0].clientY;
            
            const diffX = startX - endX;
            const diffY = startY - endY;
            
            // Only trigger if horizontal swipe is more significant than vertical
            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
              if (diffX > 0) {
                nextImage(); // Swipe left = next image
              } else {
                previousImage(); // Swipe right = previous image
              }
            }
            
            startX = 0;
            startY = 0;
          });
          
          function nextImage() {
            if (allProductImages.length <= 1) return;
            currentImageIndex = (currentImageIndex + 1) % allProductImages.length;
            updateImage();
          }
          
          function previousImage() {
            if (allProductImages.length <= 1) return;
            currentImageIndex = currentImageIndex === 0 ? allProductImages.length - 1 : currentImageIndex - 1;
            updateImage();
          }
          
          function updateImage() {
            const currentImage = allProductImages[currentImageIndex];
            if (currentImage) {
              zoomImg.style.transform = 'scale(0.9)';
              setTimeout(() => {
                zoomImg.src = currentImage.src;
                zoomImg.alt = currentImage.alt;
                imageCounter.textContent = `${currentImageIndex + 1} / ${allProductImages.length}`;
                zoomImg.style.transform = 'scale(1)';
              }, 200);
            }
          }
          
          function closeZoom() {
            overlay.style.opacity = '0';
            zoomImg.style.transform = 'scale(0.9)';
            setTimeout(() => {
              overlay.style.display = 'none';
              document.body.style.overflow = '';
            }, 300);
          }
        }
        
        // Show overlay with animation
        const zoomImg = overlay.querySelector('#zoom-carousel-image');
        const imageCounter = overlay.querySelector('#image-counter');
        const leftArrow = overlay.querySelector('button:nth-of-type(1)');
        const rightArrow = overlay.querySelector('button:nth-of-type(2)');
        
        zoomImg.src = image.src;
        zoomImg.alt = image.alt;
        imageCounter.textContent = `${currentImageIndex + 1} / ${allProductImages.length}`;
        
        // Show/hide arrows based on image count
        if (allProductImages.length <= 1) {
          leftArrow.style.display = 'none';
          rightArrow.style.display = 'none';
        } else {
          leftArrow.style.display = 'flex';
          rightArrow.style.display = 'flex';
        }
        
        overlay.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        
        // Trigger animations
        setTimeout(() => {
          overlay.style.opacity = '1';
          zoomImg.style.transform = 'scale(1)';
        }, 10);
      }
    });
  </script>

  <style>
    /* Gallery layout */
    .product-gallery {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .product-main-image {
      flex: 1 1 65%;
      text-align: center;
    }
    .product-main-image img {
      max-width: 100%;
      height: auto;
      touch-action: none !important;
      pointer-events: none !important;
    }
    
    /* Premium zoom enhancements */
    .product-main-image {
      overflow: hidden;
      border-radius: 8px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      transition: box-shadow 0.3s ease;
    }
    
    .product-main-image:hover {
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
    }
    
    .product-main-image img {
      pointer-events: auto !important;
      transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      will-change: transform;
    }
    
    /* Subtle zoom hint */
    .product-main-image::after {
      content: '🔍';
      position: absolute;
      bottom: 15px;
      right: 15px;
      background: rgba(0, 0, 0, 0.7);
      color: white;
      padding: 8px 12px;
      border-radius: 20px;
      font-size: 14px;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.3s ease;
      pointer-events: none;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    
    .product-main-image:hover::after {
      opacity: 1;
      transform: translateY(0);
    }
    
    /* Mobile: hide hint */
    @media (max-width: 768px) {
      .product-main-image::after {
        display: none;
      }
    }
    
    /* Carousel arrow hover effects */
    #zoom-overlay button:hover {
      opacity: 1 !important;
      transform: translateY(-50%) scale(1.1) !important;
      background: rgba(255, 255, 255, 1) !important;
    }
    
    /* Mobile responsive arrows */
    @media (max-width: 768px) {
      #zoom-overlay button {
        width: 40px !important;
        height: 40px !important;
        font-size: 18px !important;
      }
      
      #zoom-overlay button:first-of-type {
        left: 10px !important;
      }
      
      #zoom-overlay button:nth-of-type(2) {
        right: 10px !important;
      }
    }
    
    /* Image counter mobile positioning */
    @media (max-width: 768px) {
      #image-counter {
        bottom: -40px !important;
        font-size: 12px !important;
        padding: 6px 12px !important;
      }
    }
    
    /* Better image alignment and sizing */
    #zoom-carousel-image {
      max-width: 80% !important;
      max-height: 80% !important;
      width: auto !important;
      height: auto !important;
      object-fit: contain !important;
    }
    
    /* Ensure proper centering */
    #zoom-overlay {
      align-items: center !important;
      justify-content: center !important;
    }
    
    /* Mobile image sizing */
    @media (max-width: 768px) {
      #zoom-carousel-image {
        max-width: 90% !important;
        max-height: 90% !important;
      }
    }
    .product-thumbs {
      flex: 0 0 120px;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .product-thumbs .thumb {
      border: none;
      padding: 0;
      background: transparent;
      cursor: pointer;
    }
    .product-thumbs .thumb.active img {
      outline: 2px solid #000;
    }
    /* Mobile layout: thumbnails below main image */
    @media (max-width: 768px) {
      .product-gallery {
        flex-direction: column;
      }
      .product-thumbs {
        order: 2; /* below */
        flex-direction: row;
        justify-content: center;
        flex-wrap: wrap;
      }
      .product-thumbs .thumb img {
        width: 60px;
        height: 60px;
      }
      .product-main-image {
        order: 1;
      }
    }
  </style>

  <!-- Main image -->
  <div class="product-main-image">
    {%- if product.featured_image -%}
      {%- assign featured_large = product.featured_image | img_url: '1024x1024' -%}
      <img
        id="main-product-image"
        src="{{ featured_large }}"
        width="1024"
        height="1024"
        alt="{{ product.title | escape }}"
        loading="eager"
        decoding="async"
      >
    {%- endif -%}
  </div>

  <!-- Thumbnails -->
  <div class="product-thumbs" role="tablist" aria-label="{{ 'products.product.media.thumbnails' | t }}">
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        {%- assign thumb_url = media | img_url: '200x200' -%}
        {%- assign large_url = media | img_url: '1024x1024' -%}
        <button
          type="button"
          class="thumb{% if forloop.first %} active{% endif %}"
          data-large="{{ large_url }}"
          aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
        >
          <img
            src="{{ thumb_url }}"
            width="200"
            height="200"
            alt="{{ media.alt | escape }}"
            loading="lazy"
            decoding="async"
          >
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <style>
  /* Base gallery layout */
  .product-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .product-main-image {
    flex: 1 1 65%;
    text-align: center;
  }
  .product-main-image img {
    max-width: 100%;
    height: auto;
  }
  .product-thumbs {
    flex: 0 0 120px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .product-thumbs .thumb {
    border: none;
    padding: 1px;
    background: transparent;
    cursor: pointer;
  }
  .product-thumbs .thumb.active img {
    outline: 2px solid #000;
  }

  /* Mobile layout: thumbnails below main image in one row with scroll */
  @media (max-width: 768px) {
    /* kill vertical padding inside the buttons */
    .product-thumbs .thumb {
      padding: 0 !important;     /* remove button padding */
      margin: 0 !important;      /* optional: remove margins */
      background: none !important; /* optional: no bg */
    }
  
    /* also make sure the images fill the button */
    .product-thumbs .thumb img {
      display: block;
      width: 70px;
      height: 70px;
    }
  }
  
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const thumbs = document.querySelectorAll(".product-thumbs .thumb");
    const mainImage = document.querySelector(".product-main-image img");
  
    thumbs.forEach(button => {
      button.addEventListener("click", function() {
        const largeUrl = this.getAttribute("data-large");
        const alt = this.querySelector("img").getAttribute("alt");
  
        // update main image
        mainImage.setAttribute("src", largeUrl);
        mainImage.setAttribute("alt", alt);
  
        // highlight active thumb
        thumbs.forEach(b => b.classList.remove("active"));
        this.classList.add("active");
      });
    });
  
    // 🚫 Disable all zoom behavior
    mainImage.style.cursor = "default";
    mainImage.style.transform = "none";
    mainImage.style.transition = "none";
    console.log("🔒 All zoom effects disabled (desktop + mobile)");
  });
  </script>
  
<script>
document.addEventListener("DOMContentLoaded", function () {
  const mainImage = document.getElementById("main-product-image");

  if (window.innerWidth <= 768) { // only for mobile
    let zoomed = false;
    let startX, startY, x = 0, y = 0;

    mainImage.addEventListener("touchstart", function (e) {
      if (!zoomed) {
        mainImage.style.transform = "scale(2)";
        zoomed = true;
        mainImage.style.cursor = "grabbing";
        startX = e.touches[0].clientX - x;
        startY = e.touches[0].clientY - y;
      } else {
        mainImage.style.transform = "scale(1) translate(0px, 0px)";
        zoomed = false;
        x = 0;
        y = 0;
        mainImage.style.cursor = "grab";
      }
    });

    mainImage.addEventListener("touchmove", function (e) {
      if (zoomed) {
        e.preventDefault(); // prevent scrolling while dragging
        x = e.touches[0].clientX - startX;
        y = e.touches[0].clientY - startY;
        mainImage.style.transform = `scale(2) translate(${x}px, ${y}px)`;
      }
    });
  }
});
</script>



</div>
