        "custom_liquid": "<!-- Radiant Gradient Footer -->\n<footer class=\"gradient-footer\">\n  <div class=\"footer-center\">\n    <h2>About Us</h2>\n    <p>Because your wellness deserve more than maintenance .</p>\n    <p>--It deserve transformation</p>\n  </div>\n</footer>\n\n<style>\n.gradient-footer {\n  background: linear-gradient(135deg, #8cb697, #5c7f6f); /* Same radiant green gradient */\n  color: #fff;\n  text-align: center;\n  padding: 80px 20px;\n  font-family: 'Arial', sans-serif;\n}\n\n.gradient-footer h2 {\n  font-size: 36px;\n  font-weight: 700;\n  margin-bottom: 10px;\n  color: #fff; /* Ensures CONTACT is white */\n}\n\n.gradient-footer p {\n  font-size: 18px;\n  font-weight: 400;\n  opacity: 0.9;\n}\n</style>",
