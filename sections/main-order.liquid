<div class="account-order-wrapper">

  <!-- Back to Account Button -->
  <a href="/account" class="back-btn">← Back to Account</a>

  <!-- Order Header -->
  <div class="order-card">
    <h2>Order {{ order.name }}</h2>
    <p>Placed on {{ order.created_at | date: "%B %d, %Y" }}</p>
    <p><strong>Payment:</strong> {{ order.financial_status_label }}</p>
    <p><strong>Fulfillment:</strong> {{ order.fulfillment_status_label }}</p>
  </div>

  <!-- Product List -->
  <div class="order-products">
    <h3>Items in this order</h3>
    {% for line_item in order.line_items %}
      <div class="order-item">
        <div class="order-item__image">
          {% if line_item.image %}
 <img 
  src="{{ line_item.image | image_url: width: 200, height: 200, crop: 'center' }}" 
  width="200" 
  height="200"
  alt="{{ line_item.title | escape }}"
  loading="lazy">
          {% endif %}
        </div>
        <div class="order-item__details">
          <p class="order-item__title">{{ line_item.title }}</p>
          <p>Qty: {{ line_item.quantity }}</p>
          <p>{{ line_item.final_line_price | money }}</p>
        </div>
      </div>
    {% endfor %}
  </div>

  <!-- Order Summary -->
  <div class="order-summary">
    <h3>Order Summary</h3>
    <p><span>Subtotal:</span> {{ order.subtotal_price | money }}</p>
    {% if order.total_discounts > 0 %}
      <p><span>Discounts:</span> -{{ order.total_discounts | money }}</p>
    {% endif %}
    <p><span>Shipping:</span> {{ order.total_shipping_price_set.shop_money.amount | money }}</p>
    <p><span>Taxes:</span> {{ order.total_tax | money }}</p>
    <p class="total"><span>Total:</span> {{ order.total_price | money }}</p>
  </div>

  <!-- Addresses -->
  <div class="order-addresses">
    <div class="address-card">
      <h3>Shipping Address</h3>
      {% if order.shipping_address %}
        <p>{{ order.shipping_address.name }}</p>
        <p>{{ order.shipping_address.address1 }}</p>
        <p>{{ order.shipping_address.city }}, {{ order.shipping_address.province }}</p>
        <p>{{ order.shipping_address.country }} - {{ order.shipping_address.zip }}</p>
      {% else %}
        <p>No shipping address available.</p>
      {% endif %}
    </div>

    <div class="address-card">
      <h3>Billing Address</h3>
      {% if order.billing_address %}
        <p>{{ order.billing_address.name }}</p>
        <p>{{ order.billing_address.address1 }}</p>
        <p>{{ order.billing_address.city }}, {{ order.billing_address.province }}</p>
        <p>{{ order.billing_address.country }} - {{ order.billing_address.zip }}</p>
      {% else %}
        <p>No billing address available.</p>
      {% endif %}
    </div>
  </div>
</div>

<style>
.account-order-wrapper {
  max-width: 900px;
  margin: auto;
  padding: 20px;
  font-family: sans-serif;
}

/* Back Button */
.back-btn {
  display: inline-block;
  margin-bottom: 15px;
  padding: 10px 18px;
  background: #235C42;
  color: #fff;
  text-decoration: none;
  border-radius: 8px;
  font-size: 14px;
  transition: background 0.3s ease;
}
.back-btn:hover {
  background: #1a4532;
}

/* Order Section Cards */
.order-card, .order-products, .order-summary, .order-addresses {
  background: #fff;
  padding: 16px;
  margin-bottom: 20px;
  border-radius: 12px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}
.order-card h2 {
  color: #235C42;
}

/* FIXED PRODUCT IMAGE ALIGNMENT */
.order-item {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 20px;
  border-bottom: 1px solid #eee;
  padding-bottom: 15px;
}

.order-item__image {
  flex-shrink: 0;
  width: 120px;
}

.order-item__image img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  object-fit: contain;
  display: block;
}

.order-item__details {
  flex: 1;
}

.order-item__title {
  font-weight: 600;
  color: #222;
  margin-bottom: 4px;
}

.order-item__details p {
  margin: 2px 0;
  font-size: 14px;
  color: #555;
}

/* Order Summary */
.order-summary p {
  display: flex;
  justify-content: space-between;
  margin: 5px 0;
}
.order-summary .total {
  font-weight: bold;
  font-size: 1.1em;
}

/* Addresses */
.order-addresses {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.address-card {
  background: #f9f9f9;
  padding: 12px;
  border-radius: 10px;
}

/* Responsive */
@media (max-width: 768px) {
  .order-addresses {
    grid-template-columns: 1fr;
  }
  .order-item {
    flex-direction: column;
    align-items: flex-start;
  }
  .order-item__image {
    width: 100%;
    max-width: 300px;
  }
  .order-item__image img {
    width: 100%;
  }
}
@media (max-width: 768px) {
  .order-addresses {
    grid-template-columns: 1fr;
  }
  .order-item {
    flex-direction: column;
    align-items: flex-start;
  }
  .order-item__image {
    width: 100%;
    max-width: 300px;
  }
  .order-item__image img {
    width: 100%;
  }
}

</style>
